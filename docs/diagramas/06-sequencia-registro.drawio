        </mxCell>
        <mxCell id="c34" value="11 e 12: o aplicador trava a chave, aplica os pendentes em ordem de sequência e marca cada um como APLICADO. Mensagem repetida não acha pendentes e só confirma (RnF-003)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
