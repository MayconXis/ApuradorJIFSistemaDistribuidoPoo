        <mxCell id="c33" value="4: o evento é gravado como PENDENTE antes de publicar. A partir daí ele não se perde (RnF-002)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
