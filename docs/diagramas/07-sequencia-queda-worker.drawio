        </mxCell>
        <mxCell id="c31" value="4 e 5: só as chaves do worker-1 mudam de dono. Cada uma vai ao próximo worker do anel com carga abaixo do teto." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
