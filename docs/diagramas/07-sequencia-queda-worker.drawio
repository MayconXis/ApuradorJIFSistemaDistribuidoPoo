        <mxCell id="c30" value="Entre 12 e 13: o k3s recria o pod do worker-1 (complemento nativo). A mensagem antiga da fila dele é entregue de novo e não muda a tabela, porque o evento já está APLICADO." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
