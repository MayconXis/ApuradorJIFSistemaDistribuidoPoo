<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.ifg.apurador</groupId>
    <artifactId>apurador-jif</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Apurador JIF</name>
    <description>Apuração das competições do JIF: trabalho final de POO e de Sistemas Distribuídos</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.48</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>core</module>
        <module>cluster</module>
        <module>persistencia</module>
        <module>dispatcher</module>
        <module>worker</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.edu.ifg.apurador</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifg.apurador</groupId>
                <artifactId>cluster</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifg.apurador</groupId>
                <artifactId>persistencia</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifg.apurador</groupId>
                <artifactId>dispatcher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifg.apurador</groupId>
                <artifactId>worker</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>integracao</id>
            <modules>
                <module>integracao</module>
            </modules>
        </profile>
    </profiles>
</project>
